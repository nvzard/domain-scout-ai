{
  "manifest_version": 3,
  "name": "Domain Scout AI - Fast Domain Search",
  "version": "1.1.0",
  "description": "AI domain name ideator & instant bulk availability checker for .com, .io, .ai and more. Hunt available startup names in seconds.",
  "author": "Zulu",
  "browser_specific_settings": {
    "gecko": {
      "id": "domain-scout@zulu.tools",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Domain Scout AI - Fast Domain Search",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "cookies"
  ],
  "host_permissions": [
    "https://cloud.instantdomainsearch.com/*",
    "https://chatgpt.com/*",
    "https://*.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
