[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        {
          "header": "sec-fetch-site",
          "operation": "set",
          "value": "same-origin"
        },
        {
          "header": "origin",
          "operation": "set",
          "value": "https://instantdomainsearch.com"
        },
        {
          "header": "referer",
          "operation": "set",
          "value": "https://instantdomainsearch.com/"
        }
      ]
    },
    "condition": {
      "urlFilter": "*instantdomainsearch.com/*",
      "resourceTypes": ["xmlhttprequest"]
    }
  }
]

